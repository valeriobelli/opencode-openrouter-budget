{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-openrouter-budget",
  "version": "0.0.0",
  "description": "OpenCode plugin that surfaces real OpenRouter spend: per-request costs in the session sidebar, the model the router picked, key budget, and account credits",
  "keywords": [
    "budget",
    "cost",
    "opencode",
    "opencode-plugin",
    "openrouter",
    "plugin",
    "spend",
    "usage"
  ],
  "homepage": "https://github.com/valeriobelli/opencode-openrouter-budget#readme",
  "bugs": {
    "url": "https://github.com/valeriobelli/opencode-openrouter-budget/issues"
  },
  "license": "MIT",
  "author": "Valerio Belli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valeriobelli/opencode-openrouter-budget.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node test/parse.check.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "changeset": "changeset",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.29"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@opentui/solid": "0.6.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "solid-js": "1.9.17",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.13.0"
}
